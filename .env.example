# ==============================================================================
# Organic Trace — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values before deployment.
# NEVER commit actual secrets, API keys, or production private keys to Git.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=organic
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=organic_trace
POSTGRES_PORT=5432
DATABASE_URL="postgresql://organic:replace_with_strong_db_password@localhost:5432/organic_trace?schema=public"

# --- Backend API & Authentication ---
PORT=5000
BACKEND_PORT=5000
JWT_SECRET="replace_with_at_least_32_byte_random_secret"

# --- Blockchain / Hardhat EVM ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
HARDHAT_PORT=8545
CONTRACT_ADDRESS=
# Leave empty in local development to use the local Hardhat test signer automatically,
# or provide a dedicated non-production deployer key via secret manager:
PRIVATE_KEY=

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000

# --- Local AI Assistant (Ollama only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=llama3.2:latest
