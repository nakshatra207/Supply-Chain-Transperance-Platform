# ==============================================================================
# Organic Trace — Git Ignore Configuration
# Prevents heavy dependencies, build artifacts, sensitive keys, and logs
# from being published to GitHub.
# ==============================================================================

# --- Dependencies (Heavy files) ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# --- Python Caches & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# --- Environment Variables & Secrets (Sensitive files) ---
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
*.pem
*.key

# --- Blockchain / Hardhat Artifacts (Heavy generated files) ---
contracts/artifacts/
contracts/cache/
contracts/typechain/
contracts/typechain-types/

# --- Build Outputs ---
dist/
*/dist/
build/
backend/dist/
frontend/dist/

# --- Database & Persistent Storage ---
*.sqlite
*.sqlite3
*.db
organic_trace_data/
postgres_data/

# --- Logs, PIDs & Runtime State ---
*.log
logs/
.pids

# --- IDE & OS Metadata ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
.idea/
*.sublime-project
*.sublime-workspace
